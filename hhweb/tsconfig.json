{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "sourceMap": true,
        "strict": true,
        "allowImportingTsExtensions": true,
        // Mirrors the alias in vite.config.ts
        "paths": {
            "$haweb/lib/*": ["../src/lib/*"]
        }
    },
    "include": ["src", "vite.config.ts"]
}
